# Environment variables for BioSouk development
# Copy to .env and adjust values for your local environment.

# Application configuration
APP_ENV=development
RUST_LOG=biosouk=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biosouk

# Server configuration
HOST=127.0.0.1
PORT=8080

# JWT configuration
# JWT_SECRET must be at least 32 bytes when APP_ENV=production.
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Argon2id configuration
ARGON2ID_MEMORY=65536
ARGON2_TIME=3
ARGON2ID_THREADS=4

# Password policy
PASSWORD_MIN_LENGTH=12

# Database pool
MAX_DB_CONNECTIONS=20
